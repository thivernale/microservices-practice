{
  "name": "order-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api-gen": "bash -c 'ng-openapi-gen --input http://localhost:8080/aggregate/$1-service/v3/api-docs --output ./src/app/services/$1' --",
    "api-gen:product": "pnpm run api-gen product",
    "api-gen:order": "pnpm run api-gen order",
    "api-gen:customer": "pnpm run api-gen customer",
    "serve:ssr:order-ui": "node dist/order-ui/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/platform-server": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@angular/ssr": "^20.3.43",
    "@primeuix/themes": "^1.2.5",
    "express": "^4.22.3",
    "keycloak-js": "^26.2.5",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^22.20.5",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-openapi-gen": "^1.1.0",
    "typescript": "~5.9.3"
  }
}
